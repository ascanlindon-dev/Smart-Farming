# Reference only: enter actual values in Railway > service > Variables.
# Do not commit a file containing real credentials.
DJANGO_SETTINGS_MODULE=backend.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
# Leave empty to use Railway's generated RAILWAY_PUBLIC_DOMAIN automatically.
# For a custom domain, set DJANGO_ALLOWED_HOSTS to its hostname (no https://).
# No VITE_API_BASE or localhost URL: the browser uses this service's /api/ paths.
TELEMETRY_API_KEY=
# Set both to the same public Google Web application client ID.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Optional provider recommendations; built-in guidance works without this.
OPENAI_API_KEY=
# Required for email signup verification and password reset.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Leave SENSOR_DB_ENGINE, PREDICTION_SYNC_DATABASE and
# PREDICTION_SYNC_NAMESPACE unset: production writes directly to DATABASE_URL.
