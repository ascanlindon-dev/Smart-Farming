# Copy to backend/.env on a NEW checkout. Keep secrets out of Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Temporary fallback readings for local development when no sensor is connected.
# Values are persisted every 20 seconds while the dashboard is being used.
SENSOR_SIMULATION_ENABLED=true
# Needed only for a separate frontend origin; the Vite proxy is same-origin.
DJANGO_CSRF_TRUSTED_ORIGINS=
# SQLite is the default. Set DATABASE_URL to use PostgreSQL/Supabase.
DATABASE_URL=
# Alternatively use existing separate PostgreSQL credentials:
# DB_ENGINE=postgresql
# DB_NAME=postgres
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_PORT=6543
# DB_SSLMODE=require
# To store only sensor readings in Supabase, use the DB_* credentials above
# with SENSOR_DB_ENGINE=postgresql and leave DB_ENGINE/DATABASE_URL unset.
# Accounts and sessions then stay in the existing local database.
# SENSOR_DB_ENGINE=postgresql
# Also copy leaf/fruit scan results to that database:
# PREDICTION_SYNC_DATABASE=sensors
# PREDICTION_SYNC_NAMESPACE=<generate one UUID per local database; keep it stable>
# Prepare cloud columns and copy saved scans with: python manage.py sync_predictions --prepare
# Open-Meteo is the weather provider. Optional commercial customer key:
OPEN_METEO_API_KEY=
# Optional generated recommendations; built-in guidance works without this.
OPENAI_API_KEY=
# Blank uses the bundled Google client ID, matching the frontend default.
# For your own client, use the same ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Email signup/reset uses Gmail OAuth; see setup_gmail_oauth.py.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
